{
  "name": "liaozhai-unofficial-register",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build && npm run build:standalone",
    "build:standalone": "vite build --config vite.standalone.config.ts && node scripts/embed-standalone-assets.mjs && node scripts/verify-standalone.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:visual": "playwright test",
    "test:visual:update": "playwright test --update-snapshots",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "optimize:svg": "svgo --config svgo.config.mjs --folder public/assets/ornaments --recursive --final-newline"
  },
  "dependencies": {
    "@fontsource-variable/literata": "5.3.0",
    "@fontsource-variable/noto-serif-sc": "5.3.0",
    "@fontsource/barlow-condensed": "5.3.0",
    "@xyflow/react": "12.11.2",
    "d3-scale": "4.0.2",
    "gsap": "3.15.0",
    "lucide-react": "1.28.0",
    "motion": "^13.0.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@playwright/test": "1.62.1",
    "@storybook/addon-a11y": "10.5.7",
    "@storybook/addon-docs": "10.5.7",
    "@storybook/react-vite": "10.5.7",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.3",
    "@types/d3-scale": "4.0.9",
    "@types/node": "^26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "jsdom": "29.0.0",
    "storybook": "10.5.7",
    "svgo": "4.0.2",
    "typescript": "7.0.2",
    "vite": "8.2.1",
    "vite-plugin-singlefile": "2.3.3",
    "vitest": "4.1.10"
  }
}
